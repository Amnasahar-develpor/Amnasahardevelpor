# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values you need.
# The site runs without any of these variables (browser speech + local storage).
# ---------------------------------------------------------------------------

# Port for the Express API / production server
PORT=3001

# Folder where projects, certificates, services, messages and uploads persist.
# On hosting platforms with a persistent disk, point this at the mounted disk.
DATA_DIR=./data

# Password for Admin Mode. If omitted, the default is 12345 (as requested).
ADMIN_PASSWORD=12345

# Secret used to sign admin session cookies. CHANGE THIS before publishing.
SESSION_SECRET=replace-with-a-long-random-string

# Set to true when the site is served over HTTPS (recommended in production).
COOKIE_SECURE=false

# Optional: contact email shown on the site and used as the Reply-To address.
CONTACT_EMAIL=

# Optional: SMTP settings for emailing contact form submissions.
# Without SMTP, submissions are still stored permanently in Admin Mode > Messages.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: premium neural voice for the AI assistant (ElevenLabs).
# Without this, the assistant uses the free, built-in browser Speech Synthesis API.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
